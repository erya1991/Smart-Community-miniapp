{
  "name": "daguanglu-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "大光路智慧社区住户端与商户端 uni-app 工作区",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:resident:h5": "npm.cmd run dev:h5 --workspace=@daguanglu/resident-miniapp",
    "dev:resident:mp-weixin": "npm.cmd run dev:mp-weixin --workspace=@daguanglu/resident-miniapp",
    "build:resident:h5": "npm.cmd run build:h5 --workspace=@daguanglu/resident-miniapp",
    "build:resident:mp-weixin": "npm.cmd run build:mp-weixin --workspace=@daguanglu/resident-miniapp",
    "dev:merchant:h5": "npm.cmd run dev:h5 --workspace=@daguanglu/merchant-miniapp",
    "dev:merchant:mp-weixin": "npm.cmd run dev:mp-weixin --workspace=@daguanglu/merchant-miniapp",
    "build:merchant:h5": "npm.cmd run build:h5 --workspace=@daguanglu/merchant-miniapp",
    "build:merchant:mp-weixin": "npm.cmd run build:mp-weixin --workspace=@daguanglu/merchant-miniapp",
    "type-check:resident": "vue-tsc --noEmit -p apps/resident-miniapp/tsconfig.json",
    "type-check:merchant": "vue-tsc --noEmit -p apps/merchant-miniapp/tsconfig.json",
    "type-check": "npm.cmd run type-check:resident && npm.cmd run type-check:merchant",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "@vue/shared": "3.4.21",
    "vue": "3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vue/runtime-core": "3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "sass": "^1.77.8",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  }
}
